{
  "name": "kala-pathar-backend",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    
    "seed:admin": "tsx src/utils/seedAdmin.ts",
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc --project tsconfig.json",
    
    "start": "NODE_ENV=production node dist/index.js",
    "start:dev": "NODE_ENV=development node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop kala-pathar-backend",
    "pm2:restart": "pm2 restart kala-pathar-backend",
    "pm2:logs": "pm2 logs kala-pathar-backend",
    "pm2:list": "pm2 list",
    
    "docker:build": "docker build -t kala-pathar-backend .",
    "docker:run": "docker run -d -p 5010:5000 --env-file .env.production --name kala-backend kala-pathar-backend",
    "docker:stop": "docker stop kala-backend && docker rm kala-backend",
    "docker:logs": "docker logs kala-backend -f",
    "docker:exec": "docker exec -it kala-backend sh",
    
    "compose:up": "docker-compose up -d",
    "compose:up:build": "docker-compose up -d --build",
    "compose:down": "docker-compose down",
    "compose:logs": "docker-compose logs -f",
    "compose:rebuild": "docker-compose down && docker-compose up -d --build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "argon2": "^0.44.0",
    "bullmq": "^5.79.2",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.0",
    "rate-limiter-flexible": "^11.2.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^8.0.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
